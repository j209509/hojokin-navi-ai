datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ─── NextAuth.js v5 必須テーブル ─────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── ユーザー関連 ────────────────────────────────

model User {
  id              String                      @id @default(uuid())
  name            String?
  email           String                      @unique
  emailVerified   DateTime?
  image           String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  accounts        Account[]
  sessions        Session[]
  applications    Application[]
  bookmarks       Bookmark[]
  profile         UserProfile?
  subsidyStatuses SubsidyApplicationStatus[]
  matchingHistories MatchingHistory[]
}

model UserProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  companyName   String?
  industry      String?
  employeeCount String?
  annualRevenue String?
  prefecture    String?
  budget        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── 補助金関連 ──────────────────────────────────

model Grant {
  id              String                      @id @default(uuid())
  name            String
  ministry        String                      // 経産省 | 厚労省 | 農水省 | 自治体 etc.
  category        String                      // デジタル化 | 設備投資 | 人材育成 etc.
  description     String                      @db.Text
  maxAmount       Int                         // 万円単位
  adoptionRate    Float?                      // 採択率 (0-100)
  deadline        String?                     // 締切日テキスト
  tags            String[]                    // タグ一覧
  isActive        Boolean                     @default(true)
  jgrantsId       String?                     @unique // jGrants API の ID（重複防止用）
  url             String?                     // 補助金詳細ページURL
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  applications    Application[]
  bookmarks       Bookmark[]
  subsidyStatuses SubsidyApplicationStatus[]
}

model Application {
  id          String    @id @default(uuid())
  userId      String
  grantId     String
  status      String    @default("準備中") // 準備中 | 申請済 | 結果待ち | 採択 | 不採択
  notes       String?   @db.Text
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  grant       Grant     @relation(fields: [grantId], references: [id])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  grantId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grant     Grant    @relation(fields: [grantId], references: [id])

  @@unique([userId, grantId])
}

model Template {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  category  String
  format    String   @default("Word")
  downloads Int      @default(0)
  rating    Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MatchingHistory {
  id            String   @id @default(uuid())
  userId        String
  title         String
  businessDesc  String   @db.Text
  industry      String
  employeeCount String?
  region        String?
  resultsJson   Json
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("matching_histories")
}

model SubsidyApplicationStatus {
  id        String   @id @default(uuid())
  userId    String
  subsidyId String
  status    String   // 準備中 | 申請済 | 結果待ち | 採択 | 不採択
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grant     Grant    @relation(fields: [subsidyId], references: [id])

  @@map("subsidy_application_statuses")
}
